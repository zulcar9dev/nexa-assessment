# PENTING: Jangan commit file ini ke repository!
# Copy file ini dan isi dengan nilai yang sesuai.

# Database Connection
# Ganti dengan kredensial production yang sebenarnya
DATABASE_URL="postgresql://bni_user:STRONG_PASSWORD_HERE@db-server:5432/bni_kredit_konsumer"

# NextAuth Configuration
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_SECRET="GANTI_DENGAN_SECRET_YANG_KUAT"
NEXTAUTH_URL="https://your-domain.bni.co.id"

# Node Environment
NODE_ENV="production"
